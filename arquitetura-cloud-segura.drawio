        <mxCell id="v68" value="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="v5">
          <mxGeometry x="-15" y="140" width="24" height="24" as="geometry" />
