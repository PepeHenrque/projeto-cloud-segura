        <mxCell id="v46" value="Amazon S3 (logs)&lt;br&gt;(Object Lock, imutável)" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=#ffffff;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;fontColor=#232F3E;whiteSpace=nowrap;" vertex="1" parent="v39">
