        <mxCell id="e65" value="TLS (UDP 443)&lt;br&gt;SAML + MFA" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;rounded=0;strokeColor=#147EBA;" edge="1" parent="1" source="v4" target="v22">
