        <mxCell id="v69" value="2" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="v5">
          <mxGeometry x="0" y="200" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v70" value="3" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="v5">
          <mxGeometry x="212" y="206" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v71" value="4" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="v5">
          <mxGeometry x="728" y="310" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v72" value="5" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="v5">
          <mxGeometry x="460" y="586" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v73" value="6" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="v5">
          <mxGeometry x="1082" y="440" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v74" value="7" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="v5">
          <mxGeometry x="1120" y="622" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v75" value="8" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="v5">
          <mxGeometry x="65" y="680" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v76" value="9" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="v5">
          <mxGeometry x="1470" y="878" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v77" value="10" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="v5">
          <mxGeometry x="416" y="362" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v78" value="Fluxos numerados" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1780" y="90" width="420" height="26" as="geometry" />
        </mxCell>
        <mxCell id="v79" value="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1780" y="126" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v80" value="&lt;b&gt;Route 53&lt;/b&gt; resolve o domínio da aplicação para a distribuição do CloudFront." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1814" y="128" width="386" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v81" value="2" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1780" y="184" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v82" value="Cliente acessa por &lt;b&gt;HTTPS 443&lt;/b&gt; (TLS 1.2+, certificado do ACM). O &lt;b&gt;AWS WAF&lt;/b&gt; filtra cada requisição (regras OWASP, rate limiting, reputação de IP) antes da origem." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1814" y="186" width="386" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v83" value="3" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1780" y="242" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v84" value="CloudFront encaminha à origem (&lt;b&gt;ALB&lt;/b&gt;) por HTTPS 443 via Internet Gateway. O &lt;b&gt;sg-alb&lt;/b&gt; aceita apenas o prefix list gerenciado do CloudFront; o ALB exige um cabeçalho secreto da origem." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1814" y="244" width="386" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v85" value="4" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1780" y="300" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v86" value="ALB distribui as requisições entre as tarefas &lt;b&gt;ECS Fargate&lt;/b&gt; nas duas AZs (HTTP 8080). O &lt;b&gt;sg-app&lt;/b&gt; só aceita tráfego do sg-alb." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1814" y="302" width="386" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v87" value="5" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1780" y="358" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v88" value="API acessa o &lt;b&gt;RDS PostgreSQL&lt;/b&gt; na porta 5432 com TLS. O &lt;b&gt;sg-db&lt;/b&gt; só aceita sg-app e sg-vpn." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1814" y="360" width="386" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v89" value="6" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1780" y="416" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v90" value="Arquivos enviados vão para o &lt;b&gt;S3&lt;/b&gt; pelo &lt;b&gt;Gateway Endpoint&lt;/b&gt;, sem passar pela internet. A bucket policy nega qualquer acesso que não venha do endpoint." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1814" y="418" width="386" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v91" value="7" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1780" y="474" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v92" value="API obtém a credencial do banco no &lt;b&gt;Secrets Manager&lt;/b&gt; via Interface Endpoint (PrivateLink, 443), com rotação automática." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1814" y="476" width="386" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v93" value="8" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1780" y="532" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v94" value="Equipe administrativa conecta-se ao &lt;b&gt;AWS Client VPN&lt;/b&gt; autenticando no IAM Identity Center com &lt;b&gt;MFA&lt;/b&gt;; regras de autorização liberam apenas sg-app:8080 e sg-db:5432." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1814" y="534" width="386" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v95" value="9" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1780" y="590" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v96" value="&lt;b&gt;CloudTrail&lt;/b&gt;, &lt;b&gt;Flow Logs&lt;/b&gt; e logs de ALB/WAF/VPN são centralizados no &lt;b&gt;CloudWatch&lt;/b&gt; e no S3 de logs; &lt;b&gt;GuardDuty&lt;/b&gt;, &lt;b&gt;Config&lt;/b&gt; e &lt;b&gt;Security Hub&lt;/b&gt; analisam e alertam." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1814" y="592" width="386" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v97" value="10" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#147EBA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1780" y="648" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v98" value="Saída controlada: tarefas privadas acessam atualizações/APIs externas pelo &lt;b&gt;NAT Gateway&lt;/b&gt; (somente 443 de saída; nenhuma conexão de entrada é possível)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1814" y="650" width="386" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v99" value="&lt;b style='font-size:13px'&gt;Security Groups — entrada permitida&lt;/b&gt;&lt;table style='border-collapse:collapse;width:100%;margin-top:6px' border='1' cellpadding='3'&gt;&lt;tr style='background:#F2F3F3'&gt;&lt;th&gt;SG&lt;/th&gt;&lt;th&gt;Origem&lt;/th&gt;&lt;th&gt;Porta&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;sg-alb&lt;/td&gt;&lt;td&gt;prefix list CloudFront&lt;/td&gt;&lt;td&gt;TCP 443&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td rowspan='2'&gt;sg-app&lt;/td&gt;&lt;td&gt;sg-alb&lt;/td&gt;&lt;td&gt;TCP 8080&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;sg-vpn&lt;/td&gt;&lt;td&gt;TCP 8080&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td rowspan='2'&gt;sg-db&lt;/td&gt;&lt;td&gt;sg-app&lt;/td&gt;&lt;td&gt;TCP 5432&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;sg-vpn&lt;/td&gt;&lt;td&gt;TCP 5432&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;sg-vpce&lt;/td&gt;&lt;td&gt;sg-app&lt;/td&gt;&lt;td&gt;TCP 443&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='margin-top:6px'&gt;Qualquer outra entrada é negada (deny implícito). Saída do sg-app restrita a sg-db:5432, S3/endpoints:443 e NAT:443.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=#5A6C86;fillColor=#FFFFFF;rounded=1;arcSize=2;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1780" y="712" width="420" height="215" as="geometry" />
        </mxCell>
        <mxCell id="v100" value="&lt;b style='font-size:13px;color:#DD344C'&gt;Fluxos bloqueados&lt;/b&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;Internet → ALB sem passar pelo CloudFront/WAF&lt;/li&gt;&lt;li&gt;Internet → ECS ou RDS (sem IP público, sem rota de entrada)&lt;/li&gt;&lt;li&gt;Internet → S3 (Block Public Access + aws:SourceVpce)&lt;/li&gt;&lt;li&gt;ALB ou sub-rede pública → RDS&lt;/li&gt;&lt;li&gt;SSH/RDP (22/3389) de qualquer origem&lt;/li&gt;&lt;li&gt;Conexões de entrada pelo NAT Gateway&lt;/li&gt;&lt;li&gt;Acesso administrativo sem VPN + MFA&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=#DD344C;fillColor=#FDF2F3;rounded=1;arcSize=2;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1780" y="937" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v101" value="&lt;b style='font-size:13px'&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;span style='color:#232F3E'&gt;━━&lt;/span&gt; tráfego da aplicação &amp;nbsp; &lt;span style='color:#7AA116'&gt;━━&lt;/span&gt; acesso privado a serviços&lt;br&gt;&lt;span style='color:#147EBA'&gt;━━&lt;/span&gt; acesso administrativo &amp;nbsp; &lt;span style='color:#879196'&gt;╍╍&lt;/span&gt; saída via NAT&lt;br&gt;&lt;span style='color:#DD344C'&gt;╍╍&lt;/span&gt; associação (WAF/ACM) &amp;nbsp; &lt;span style='color:#C925D1'&gt;╍╍&lt;/span&gt; replicação" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=#5A6C86;fillColor=#FFFFFF;rounded=1;arcSize=2;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1780" y="1097" width="420" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
